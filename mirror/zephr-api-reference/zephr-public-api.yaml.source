                          remainingCredits: 0
                      trialTrackingDetails:
                        - entitlementId: W28U8Z
                          entitlementType: entitlement
                          trackCreditsUsed: false
                          trackCreditsRemaining: false
                          creditsUsedKey: creditsUsed
                          creditsRemainingKey: creditsRemaining
                      trials:
                        pLvjuu:
                          totalCredits: 1

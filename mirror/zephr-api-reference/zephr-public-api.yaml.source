                    accessDetails:
                      authenticated: false
                      accessDecisions:
                        W28U8Z: false
                      entitlements:
                        W28U8Z:
                          usedInDecision: false
                          decrementedInDecision: false
                      credits:
                        W28U8Z:
                          usedInDecision: false
                          decrementedInDecision: false
                          totalCredits: 0
                          remainingCredits: 0
                      meters:
                        W28U8Z:
                          usedInDecision: false
                          decrementedInDecision: false
